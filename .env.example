# Main model: used by the reviewer, author, and score-calibration agents.
# Replace the blank values with your OpenAI-compatible provider settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
PRIORREVIEW_TEMPERATURE=0.2
PRIORREVIEW_AGENT_MAX_ATTEMPTS=3

# Final structured report. These are configured separately and are required
# for a real review run; the main model settings are not used as a fallback.
FINALIZER_OPENAI_API_KEY=
FINALIZER_OPENAI_BASE_URL=
FINALIZER_OPENAI_MODEL=
FINALIZER_OPENAI_TEMPERATURE=0.0
FINALIZER_MAX_ATTEMPTS=3

# Existing historical-prior database: PostgreSQL with pgvector.
# Use a database account with SELECT access to the tables in docs/historical-priors.md.
PRIORREVIEW_DB_HOST=127.0.0.1
PRIORREVIEW_DB_PORT=5432
PRIORREVIEW_DB_USER=
PRIORREVIEW_DB_PASSWORD=
PRIORREVIEW_DB_NAME=priorreview

# Query embeddings must match the model and dimensions of the stored vectors.
# Adjust the model identifier to match your provider and existing prior store.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Default paper workflow: initial review, one author reply, revised review,
# score calibration, and at most one reviewer verification.
PRIORREVIEW_MAX_REVIEWER_AUTHOR_ROUNDS=2
PRIORREVIEW_MAX_SC_REREVIEW_ROUNDS=1
PRIORREVIEW_REVIEWER_DATA_AGENT_ENABLED=true
PRIORREVIEW_AUTHOR_DATA_AGENT_ENABLED=true
PRIORREVIEW_SC_DATA_AGENT_ENABLED=true

# Autonomous data specialists: file tools, Python/SQL scripts, local execution,
# complete result inspection, debugging, and summaries. Commands run locally.
# Set false to retain only the fixed SQL/RAG/summary tools.
PRIORREVIEW_DATA_AGENT_CODE_EXECUTION_ENABLED=true
PRIORREVIEW_DATA_AGENT_COMMAND_TIMEOUT_SECONDS=120
PRIORREVIEW_DATA_AGENT_MAX_STEPS=100

# Runtime outputs. The CLI --output-dir option overrides this for one process.
PRIORREVIEW_RESULTS_DIR=data/results
PRIORREVIEW_CONSOLE_LOG=true
